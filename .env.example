# --- LLM (OpenAI-compatible / LiteLLM proxy) ---
OPENAI_BASE_URL=https://gpt.mfec.co.th/litellm
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-5

# --- Embeddings ---
# openai = call EMBEDDING_MODEL on the same endpoint
# hash   = local deterministic embedding (no API call; storage proof works, semantic search is rough)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large

# --- Milvus ---
# Milvus Lite (local file):            ./data/milvus_memory.db
# Milvus standalone (Docker, for Attu): http://localhost:19530
# (named MILVUS_DB_URI because pymilvus itself reads MILVUS_URI at import time)
MILVUS_DB_URI=./data/milvus_memory.db
MILVUS_COLLECTION=agent_memories
# Server only (ignored for Milvus Lite):
#   MILVUS_DB_TOKEN    "user:password" (e.g. root:Milvus) or Zilliz Cloud API key
#   MILVUS_DB_USER / MILVUS_DB_PASSWORD   alternative to TOKEN
#   MILVUS_DB_NAME     empty = "default"
#   MILVUS_DB_CREATE   true = create MILVUS_DB_NAME if missing
MILVUS_DB_TOKEN=
MILVUS_DB_USER=
MILVUS_DB_PASSWORD=
MILVUS_DB_NAME=
MILVUS_DB_CREATE=false

# --- Checkpointer (short-term memory = conversation state per thread_id) ---
# memory   = RAM, gone when the process exits
# postgres = durable; start it with `docker compose up -d postgres`
CHECKPOINTER=memory
POSTGRES_URI=postgresql://agent:agent@localhost:5432/agent_checkpoints

# --- Agent ---
AGENT_NAMESPACE=poc-agent
DEFAULT_USER_ID=earth

# --- Optional ---
TAVILY_API_KEY=
